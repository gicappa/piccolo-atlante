---
import {fotoSrcset, fotoUrl} from '../lib/image'
import type {Foto} from '../lib/types'

interface Props {
  foto: Foto
  /** rapporto larghezza/altezza per ritagliare (es. 3/2); senza, la foto resta intera */
  ratio?: number
  sizes?: string
  eager?: boolean
  didascalia?: boolean
  class?: string
}

const {foto, ratio, sizes = '(min-width: 64rem) 58rem, 100vw', eager = false, didascalia = true, class: cls} = Astro.props
const larghezza = 1600
const altezza = ratio ? Math.round(larghezza / ratio) : Math.round((larghezza * foto.height) / foto.width)
---

<figure class:list={['foto', cls]}>
  <img
    src={fotoUrl(foto, larghezza, ratio)}
    srcset={fotoSrcset(foto, ratio)}
    sizes={sizes}
    width={larghezza}
    height={altezza}
    alt={foto.alt ?? foto.didascalia ?? ''}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={ratio ? `aspect-ratio: ${ratio}; object-fit: cover` : undefined}
  />
  {didascalia && foto.didascalia && <figcaption>{foto.didascalia}</figcaption>}
</figure>

<style>
  .foto {
    margin: 0;
  }
  img {
    width: 100%;
    background: var(--carta-scura);
  }
  figcaption {
    margin-top: 0.6rem;
    font-family: var(--titoli);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--matita);
    text-align: center;
  }
</style>
